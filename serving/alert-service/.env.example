# Copy to .env for local (non-Docker) development against the docker-compose
# stack's host-mapped ports. Not loaded automatically -- this project keeps
# config to plain process.env (see src/config/env.ts) rather than adding a
# dotenv dependency; export these yourself or use `env $(cat .env) node ...`.

PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=pulseguard
POSTGRES_PASSWORD=pulseguard
POSTGRES_DB=pulseguard

KAFKA_BROKERS=localhost:9092
KAFKA_ALERTS_TOPIC=fraud.alerts
KAFKA_DISPOSITIONS_TOPIC=analyst.dispositions
KAFKAJS_NO_PARTITIONER_WARNING=1

CORS_ORIGIN=*
